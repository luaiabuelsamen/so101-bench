+class _TerminalKeyListener:
+    """Watches the controlling terminal for the record-loop control keys.
+
+    Exposes the same surface the record loop uses from a pynput listener: it is
+    started here and only ``stop()`` is called on it later. The terminal is put
+    in cbreak so keys arrive unbuffered and unechoed; ISIG stays on, so Ctrl-C
+    still interrupts. The original terminal settings are restored by ``stop()``
+    and again at interpreter exit, so a crash mid-episode cannot strand the
+    shell in cbreak.
+    """
+
+    _SEQUENCES = {
+        b"[C": ("exit_early",),
+        b"[D": ("rerecord_episode", "exit_early"),
+    }
+
+    def __init__(self, events: dict):
+        self._events = events
+        self._fd = sys.stdin.fileno()
+        self._saved = None
+        self._stopping = threading.Event()
+        self._thread = threading.Thread(
+            target=self._run, name="terminal-key-listener", daemon=True
+        )
+
+    def start(self):
+        self._saved = termios.tcgetattr(self._fd)
+        atexit.register(self._restore)
+        tty.setcbreak(self._fd)
+        self._thread.start()
+
+    def _set(self, *flags):
+        for f in flags:
+            self._events[f] = True
+
+    def _run(self):
+        while not self._stopping.is_set():
+            if not select.select([self._fd], [], [], 0.2)[0]:
+                continue
+            if os.read(self._fd, 1) != b"\x1b":
+                continue
+            # ESC alone means stop; ESC [ C / ESC [ D are the arrows. Only a
+            # short wait distinguishes them, since the arrows arrive as one burst.
+            if not select.select([self._fd], [], [], 0.05)[0]:
+                print("\nESC pressed. Stopping data recording...")
+                self._set("stop_recording", "exit_early")
+                continue
+            flags = self._SEQUENCES.get(os.read(self._fd, 2))
+            if flags:
+                print(
+                    "\nRe-recording last episode..."
+                    if "rerecord_episode" in flags
+                    else "\nMoving to next episode..."
+                )
+                self._set(*flags)
+
+    def _restore(self):
+        if self._saved is not None:
+            termios.tcsetattr(self._fd, termios.TCSADRAIN, self._saved)
+            self._saved = None
+
+    def stop(self):
+        self._stopping.set()
+        self._restore()
+
